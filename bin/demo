#!/usr/bin/env python3
"""demo - un comando per la demo AMD AI League.

Esegue i casi del corpus, scrive backend/run.json (caso primario), salva i run
per-caso, arricchisce con il throughput, copia tutto in frontend/ e stampa il
ticker. Se il generatore (OpenRouter) cade, ricade sul run congelato invece di
sporcare il run.json con numeri a zero.

Uso:
    bin/demo                      # live: 6 casi + throughput, copia in frontend/
    bin/demo --offline            # nessuna chiamata LLM (verifica veloce)
    bin/demo --frozen             # registra dal run congelato (OpenRouter giu')
    bin/demo --freeze             # dopo un run live ok, congela il run per il fallback
    bin/demo --serve              # genera e poi serve frontend/ su 0.0.0.0:8500
    bin/demo --cases FC-01,FC-04  # sottoinsieme di casi
    bin/demo --no-copy            # non tocca frontend/
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]  # repo root (il file vive in <root>/bin/)
WS = ROOT                                   # il repo E' il workspace
BACKEND = WS / "backend"
FRONTEND = WS / "frontend"
ENV_PATH = ROOT / ".env"  # assente nei clone: il loader lo ignora e si usa il run congelato
sys.path.insert(0, str(BACKEND))

import pipeline  # noqa: E402
import throughput  # noqa: E402
from retriever import DEFAULT_CORPUS_PATH, load_corpus  # noqa: E402

RUN_JSON = BACKEND / "run.json"
RUN_OFFLINE_JSON = BACKEND / "run.offline.json"
FROZEN_JSON = BACKEND / "run.frozen.json"
RUNS_DIR = BACKEND / "runs"
SUMMARY_JSON = BACKEND / "demo_runs.json"
FRONTEND_FILES = ("run.json", "baseline_metrics.json", "demo_runs.json")


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def load_env(paths: list[Path] | None = None) -> int:
    """Carica il .env come fanno i wrapper in bin/. Non stampa valori.

    Cerca in piu' posti: la copia di questo repo (clone: di solito assente, si
    usa il run congelato) e la copia operativa della macchina aziendale
    (/srv/ai-company/.env, raggiungibile anche quando bin/ e' una symlink).
    """
    candidates = paths or [ROOT / ".env", Path("/srv/ai-company/.env")]
    loaded = 0
    for path in candidates:
        if not path.exists():
            continue
        for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            key = key.strip()
            value = value.strip().strip('"').strip("'")
            if key and key not in os.environ:
                os.environ[key] = value
                loaded += 1
    return loaded


def load_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def write_json(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")


def corpus_case_ids(corpus_path: str | None = None) -> list[str]:
    cases = load_corpus(corpus_path or DEFAULT_CORPUS_PATH)
    return [str(case.get("id")) for case in cases if case.get("id")]


LEGIT_SKIP_REASONS = {"guard: evidence insufficient", "guard insufficient"}


def generator_failed(data: dict[str, Any], offline: bool) -> str | None:
    """Ritorna il motivo del fallimento del generatore, o None se e' andata.

    Non e' un fallimento se il guard ha bloccato la generazione (evidenza
    insufficiente): quello e' un esito legittimo della pipeline. E' un
    fallimento se OpenRouter ha risposto con errore o se la chiamata non e'
    partita per un motivo operativo (key mancante, contesto oltre budget...).
    """
    if offline:
        return None
    generator = (data.get("stages") or {}).get("generator") or {}
    if not generator.get("called"):
        reason = str(generator.get("error") or "").strip()
        if reason in LEGIT_SKIP_REASONS or not reason:
            return None
        return f"generatore non invocato: {reason or 'motivo ignoto'}"
    if generator.get("status") == "error":
        return str(generator.get("error") or "errore generatore")
    return None


def run_case(case_id: str, offline: bool) -> tuple[dict[str, Any] | None, str | None]:
    try:
        data = pipeline.run(case_id, offline=offline)
    except Exception as exc:  # noqa: BLE001
        return None, f"{type(exc).__name__}: {exc}"
    failure = generator_failed(data, offline)
    return data, failure


def apply_throughput(data: dict[str, Any], runs: int, offline: bool) -> None:
    if runs <= 0:
        return
    try:
        data["throughput"] = throughput.measure(runs, offline=offline)
    except Exception as exc:  # noqa: BLE001
        print(f"WARN: throughput non misurato ({type(exc).__name__}: {exc})", file=sys.stderr)


def freeze(data: dict[str, Any], reason: str) -> dict[str, Any]:
    """Copia congelata del run: numeri originali, piu' il motivo del congelamento."""
    frozen = json.loads(json.dumps(data))
    frozen["frozen"] = True
    frozen["frozen_at"] = now_iso()
    frozen["frozen_reason"] = reason
    return frozen


def mark_fallback(data: dict[str, Any], reason: str) -> dict[str, Any]:
    fallback = json.loads(json.dumps(data))
    fallback["frozen"] = True
    fallback["fallback"] = True
    fallback["fallback_at"] = now_iso()
    fallback["fallback_reason"] = reason
    return fallback


def copy_to_frontend() -> list[str]:
    copied: list[str] = []
    FRONTEND.mkdir(parents=True, exist_ok=True)
    for name in FRONTEND_FILES:
        source = BACKEND / name
        if source.exists():
            (FRONTEND / name).write_text(source.read_text(encoding="utf-8"), encoding="utf-8")
            copied.append(name)
    return copied


def row_for(case_id: str, data: dict[str, Any], failure: str | None, elapsed_ms: float) -> dict[str, Any]:
    stages = data.get("stages") or {}
    noul = stages.get("noul") or {}
    guard = stages.get("guard") or {}
    generator = stages.get("generator") or {}
    tokens = data.get("tokens") or {}
    return {
        "case_id": case_id,
        "label": (stages.get("choice") or {}).get("label"),
        "kept": noul.get("kept"),
        "total": noul.get("total"),
        "guard": guard.get("action"),
        "gen_status": generator.get("status"),
        "tokens_gen": tokens.get("gen_consumed"),
        "total_ms": data.get("total_ms"),
        "within_budget": data.get("within_budget"),
        "failure": failure,
        "elapsed_ms": round(elapsed_ms, 1),
    }


def print_summary(rows: list[dict[str, Any]]) -> None:
    print()
    print("DEMO SUMMARY")
    print("-" * 78)
    print(f"{'case':6} {'label':12} {'noul':>8} {'guard':12} {'gen':10} {'tokens':>7} {'ms':>7}")
    for row in rows:
        noul = f"{row['kept']}/{row['total']}" if row["kept"] is not None else "-"
        tokens = row["tokens_gen"] if row["tokens_gen"] is not None else "-"
        ms = f"{row['total_ms']:.0f}" if isinstance(row["total_ms"], (int, float)) else "-"
        print(
            f"{row['case_id']:6} {str(row['label'] or '-'):12} {noul:>8} "
            f"{str(row['guard'] or '-'):12} {str(row['gen_status'] or '-'):10} "
            f"{str(tokens):>7} {ms:>7}"
        )
        if row["failure"]:
            print(f"       ERROR: {row['failure'][:100]}")
    print("-" * 78)


def serve(port: int = 8500) -> int:
    print(f"serving {FRONTEND} su http://0.0.0.0:{port}/index.html (Ctrl-C per fermare)")
    return subprocess.call(
        [sys.executable, "-m", "http.server", str(port), "--bind", "0.0.0.0"],
        cwd=str(FRONTEND),
    )


def use_frozen(reason: str, args: argparse.Namespace) -> int:
    if not FROZEN_JSON.exists():
        print(f"ERROR: fallback richiesto ({reason}) ma {FROZEN_JSON.name} non esiste.", file=sys.stderr)
        print("       Rigenera con: bin/demo --freeze (quando OpenRouter torna su).", file=sys.stderr)
        return 1
    frozen = load_json(FROZEN_JSON)
    data = mark_fallback(frozen, reason)
    write_json(RUN_JSON, data)
    print()
    print("!! FALLBACK CONGELATO — numeri dal run congelato, NON da un run di adesso")
    print(f"!! motivo: {reason}")
    print(f"!! run originale misurato il: {data.get('generated_at')}")
    print()
    pipeline.print_ticker(data)
    rows = [row_for(str(data.get("case_id") or "?"), data, None, 0.0)]
    print_summary(rows)
    if not args.no_copy:
        copied = copy_to_frontend()
        print(f"frontend aggiornato: {', '.join(copied) or 'niente da copiare'}")
    if args.serve:
        return serve(args.port)
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Demo runner AMD AI League (6 casi -> run.json -> frontend)")
    parser.add_argument("--offline", action="store_true", help="nessuna chiamata al generatore")
    parser.add_argument("--frozen", action="store_true", help="usa backend/run.frozen.json senza eseguire nulla")
    parser.add_argument("--freeze", action="store_true", help="dopo un run live ok, salva il run congelato")
    parser.add_argument("--primary", default="FC-01", help="caso che finisce in run.json (default FC-01)")
    parser.add_argument("--cases", default=None, help="lista di casi separati da virgola (default: tutto il corpus)")
    parser.add_argument("--throughput", type=int, default=10, help="run paralleli per il blocco throughput (0 = salta)")
    parser.add_argument("--no-copy", action="store_true", help="non copiare in frontend/")
    parser.add_argument("--serve", action="store_true", help="serve frontend/ su 0.0.0.0:8500")
    parser.add_argument("--port", type=int, default=8500)
    args = parser.parse_args(argv)
    load_env()

    if args.frozen and args.freeze:
        print("ERROR: --frozen e --freeze sono incompatibili", file=sys.stderr)
        return 2
    if args.frozen:
        return use_frozen("richiesto --frozen", args)

    try:
        case_ids = [item.strip() for item in args.cases.split(",") if item.strip()] if args.cases else corpus_case_ids()
    except (FileNotFoundError, ValueError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    if not case_ids:
        print("ERROR: nessun caso da eseguire", file=sys.stderr)
        return 2
    if args.primary not in case_ids:
        print(f"ERROR: --primary {args.primary} non e' tra i casi da eseguire: {case_ids}", file=sys.stderr)
        return 2

    mode = "offline" if args.offline else "live"
    print(f"DEMO — {len(case_ids)} casi · modalita' {mode} · primario {args.primary}")
    print(f"corpus: {DEFAULT_CORPUS_PATH}")
    print("=" * 78)

    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    rows: list[dict[str, Any]] = []
    primary_data: dict[str, Any] | None = None
    primary_failure: str | None = None
    hard_errors = 0

    for case_id in case_ids:
        started = time.perf_counter()
        data, failure = run_case(case_id, args.offline)
        elapsed = (time.perf_counter() - started) * 1000.0
        if data is None:
            print(f"\n[{case_id}] ERROR: {failure}")
            rows.append(
                {
                    "case_id": case_id,
                    "label": None,
                    "kept": None,
                    "total": None,
                    "guard": None,
                    "gen_status": None,
                    "tokens_gen": None,
                    "total_ms": None,
                    "within_budget": None,
                    "failure": failure,
                    "elapsed_ms": round(elapsed, 1),
                }
            )
            hard_errors += 1
            if case_id == args.primary:
                primary_failure = failure
            continue

        print(f"\n[{case_id}]")
        pipeline.print_ticker(data)
        write_json(RUNS_DIR / f"{case_id}.json", data)
        rows.append(row_for(case_id, data, failure, elapsed))
        if failure:
            hard_errors += 1
        if case_id == args.primary:
            primary_data = data
            primary_failure = failure

    print_summary(rows)

    if primary_data is None:
        return use_frozen(f"caso primario {args.primary} non eseguibile: {primary_failure}", args)

    if primary_failure and not args.offline:
        return use_frozen(f"generatore fallito su {args.primary}: {primary_failure}", args)

    apply_throughput(primary_data, args.throughput, args.offline)
    # un run offline non ha chiamate LLM: non deve mai sostituire il run della demo
    target_json = RUN_OFFLINE_JSON if args.offline else RUN_JSON
    write_json(target_json, primary_data)
    if args.freeze:
        if args.offline:
            print("WARN: --freeze ignorato in modalita' offline (nessuna chiamata LLM da congelare)", file=sys.stderr)
        else:
            write_json(FROZEN_JSON, freeze(primary_data, "run live verificato, congelato per il fallback"))
            print(f"run congelato -> {FROZEN_JSON}")

    summary = {
        "generated_at": now_iso(),
        "mode": mode,
        "primary": args.primary,
        "n_cases": len(rows),
        "cases": rows,
    }
    write_json(SUMMARY_JSON, summary)
    print(f"run -> {target_json}")
    print(f"run per caso -> {RUNS_DIR}/")
    print(f"summary -> {SUMMARY_JSON}")

    if args.offline:
        print("offline: run.json e frontend/ NON toccati (usa un run live per la demo)")
    elif not args.no_copy:
        copied = copy_to_frontend()
        print(f"frontend aggiornato: {', '.join(copied) or 'niente da copiare'}")

    if args.serve:
        return serve(args.port)
    return 1 if hard_errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
