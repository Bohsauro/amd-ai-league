# =============================================================================
# SPESEMED - Configurazione ambiente
# =============================================================================
# Copia questo file in `.env` e inserisci i tuoi valori:
#   cp .env.example .env          (macOS/Linux)
#   copy .env.example .env        (Windows)
#
# IMPORTANTE: il file .env NON deve MAI essere committato (vedi .gitignore).
# =============================================================================

# --- OpenRouter ---------------------------------------------------------------
# Ottieni la tua chiave gratuita su https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modello Vision da usare (default: gemini-2.5-flash-lite, economico e preciso per OCR italiano).
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Metadata app (inviato a OpenRouter via X-Title + HTTP-Referer)
APP_NAME=SPESEMED
APP_URL=https://spesemed.local

# --- Supabase (PostgreSQL + Storage) ------------------------------------------
# Crea un progetto gratuito su https://supabase.com (500MB DB, 1GB Storage).
# Settings → API: copia "Project URL" e "service_role key" (NON anon key!).
# La service_role key bypassa RLS server-side: mai esporla al client.
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bucket Storage dove salvare le ricevute originali (ricevute/{user_id}/{hash}.ext).
# Crealo dalla dashboard Supabase: Storage → New bucket → Private.
SUPABASE_BUCKET=receipts

# JWT secret di Supabase (Settings → API → JWT Secret).
# Serve SOLO se il tuo progetto Supabase firma i JWT con HS256 (legacy/symmetric).
# I progetti Supabase moderni (post-2024) usano ES256 (EC P-256 asimmetrico):
# in quel caso basta SUPABASE_URL e il JWKS endpoint verra' auto-derivato.
# In dev/test puoi lasciarlo vuoto (fallback X-User-Id attivo).
SUPABASE_JWT_SECRET=

# Endpoint JWKS di Supabase per verifica JWT ES256 (asimmetrico).
# Default: auto-derivato da SUPABASE_URL + "/auth/v1/.well-known/jwks.json".
# Override solo se usi un proxy CDN personalizzato o mirror JWKS.
# Lascia vuoto in dev se SUPABASE_URL non e' configurato.
SUPABASE_JWKS_URL=

# --- Auth (Fase 2 ON/OFF) ----------------------------------------------------
# Se False, /auth/signup ritorna 403. Disabilitare in produzione se l'onboarding
# e' gestito tramite invito admin (default: True per self-service pubblico).
ALLOW_SIGNUP=true

# User ID mock usato in dev come fallback quando mancano header auth (mai usato in prod).
MOCK_USER_ID_DEFAULT=anonymous

# SECURITY (FIX C3): opt-in ESPLICITO per mock-auth in dev/test.
# Se True (e SUPABASE_JWT_SECRET vuoto): il Bearer token viene accettato come
#   user_id opaco senza verifica firma (utile per test offline).
# Se False (DEFAULT): l'app fail-closes con 503 quando il JWT non puo'
#   essere verificato. MAI true in produzione (identity-spoofing).
# Richiesto sempre (anche in dev) per abilitare header X-User-Id mock.
ALLOW_DEV_MOCK_AUTH=false

# --- Worker (Fase 2 async) ----------------------------------------------------
# Intervallo di polling del worker in secondi (default 2.0).
WORKER_POLL_INTERVAL_SECONDS=2.0

# Numero massimo di retry per un job prima di marcarlo 'failed' (default 3).
WORKER_MAX_ATTEMPTS=3

# Minuti dopo i quali un job 'processing' viene considerato zombie e rimesso in coda.
WORKER_ZOMBIE_TIMEOUT_MINUTES=10

# --- CORS --------------------------------------------------------------------
# Origini autorizzate per browser CORS. SECURITY (audit pen-test):
# MAI usare wildcard "*" in produzione: combinato con credentials = misconfiguration.
# Default localhost-only + Streamlit dashboard (8501) per dev locale.
# Override in produzione con la lista domini del tuo frontend, es.:
#   CORS_ORIGINS=https://app.spesemed.it,https://admin.spesemed.it
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:3000,http://127.0.0.1:8501
CORS_ALLOW_CREDENTIALS=false

# --- Upload limits -----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
MAX_SYNC_FILES=3
MAX_ASYNC_FILES=50

# --- Rate limiting (Fase 3 + Fase 4 Redis) ----------------------------------
# Stringa nel formato slowapi: "N/periodo" dove periodo = second|minute|hour|day.
#
# STORAGE BACKEND:
#   - "memory" (default): in-memory, PER-WORKER. OK solo per API_WORKERS=1.
#   - "redis" + REDIS_URL: Redis condiviso, OBBLIGATORIO per API_WORKERS>1.
#     Con memory + multi-worker, i limiti vengono moltiplicati x N worker
#     (es. "5/minute" con 2 worker = 10/minute effettivi per utente).
#   - "redis://host:port/db": URI Redis diretta (salta REDIS_URL).
#
# Per produzione multi-worker:
#   RATE_LIMIT_STORAGE_BACKEND=redis
#   REDIS_URL=redis://redis:6379/0
RATE_LIMIT_EXTRACT=10/minute
RATE_LIMIT_JOBS=60/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=2/hour
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_LOGOUT=20/minute
RATE_LIMIT_EXPORT=10/minute
RATE_LIMIT_STORAGE_BACKEND=memory

# --- Redis (Fase 4 - rate-limit multi-worker) ---------------------------------
# Obbligatorio per produzione con API_WORKERS > 1.
# Formato: redis://[user]:[password]@host:port/db
REDIS_URL=

# --- Monitoring (Fase 3 + 3.5 Prometheus) ------------------------------------
# Sentry DSN per error tracking (vuoto = disabilitato). https://sentry.io
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus metrics endpoint /metrics (default: abilitato).
# Disabilitare solo dietro reverse proxy che fa auth custom o se non si usa Prometheus.
PROMETHEUS_METRICS_ENABLED=true

# Token statico per endpoint admin (es. POST /admin/auth/reset-jwks-cache).
# Header atteso: X-Admin-Token. Vuoto = endpoint disabilitato (403 fail-closed).
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECURITY:
#   - 32+ chars base64url (secrets.token_urlsafe(32)).
#   - Ruotare ogni 90 giorni (revoca + nuovo valore).
#   - MAI committare in git: solo via secrets manager / vault.
#   - Protezione addizionale: reverse proxy IP allowlist per /admin/* (vedi
#     deployment/Caddyfile o deployment/nginx.conf).
#   - In produzione il Caddyfile/nginx.conf limitano /admin a localhost + IP Ops.
ADMIN_TOKEN=

# --- API metadata ------------------------------------------------------------
# Versione API (solo lettura, mostrata in /health e OpenAPI schema).
API_VERSION=0.3.0

# Ambiente: development | production. Cambia logging verbosity + lock JWT.
API_ENV=development
# Numero worker uvicorn (1 in dev, 2-4 in produzione dietro reverse proxy).
API_WORKERS=1

# --- METRICS SECURITY ---
METRICS_IP_ALLOWLIST=["127.0.0.1"]
METRICS_TRUST_XFF=false

# --- Stripe billing (Fase 4C) -------------------------------------------------
# No-op mode: se STRIPE_SECRET_KEY e' vuota, /billing/checkout risponde 503 e
# /billing/plan ritorna stripe_configured=false. Il codice NON contiene secrets:
# tutto arriva da questo file (.env, mai committato).
#
# Per ATTIVARE il billing:
#   1. Account Stripe → Dashboard → Developers → API keys: copia la SECRET key.
#   2. Crea un Product → Price ricorrente (es. 9.99 EUR/mese) → copia il
#      price_id (formato price_1Q...).
#   3. Stripe → Developers → Webhooks → "Add endpoint":
#        URL = https://<api-host>/api/v1/billing/webhook
#        Eventi = checkout.session.completed, customer.subscription.deleted
#      Copia la "Signing secret" (whsec_...) generata da Stripe.
#   4. (Opzionale) applica migrations/004_stripe_subscriptions.sql su Supabase
#      per persistere le subscription.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_CURRENCY=eur
STRIPE_SUCCESS_URL=https://app.spesemed.local/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://app.spesemed.local/billing/cancel