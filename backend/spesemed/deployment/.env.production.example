[TEMPLATE]
# =============================================================================
# SPESEMED - PRODUCTION Environment (.env.production)
# =============================================================================
# Questo file è un TEMPLATE per produzione. NON copiarlo come `.env`!
# Genera invece `.env` a partire da:
#   1. cp .env.example .env     (template base)
#   2. Sovrascrivi le env seguenti con i valori reali del tuo ambiente.
#   3. MAI committare `.env` (vedi .gitignore).
#
# ⚠️  ENV VARS PRODUZIONE-SPECIFICHE (override .env.example):
# =============================================================================

# --- Production hardening ----------------------------------------------------

# CRITICAL: fail-closed su JWT secret mancante (FIX C3).
# Mai true in produzione (identity spoofing se attaccante ottiene il dev server).
ALLOW_DEV_MOCK_AUTH=false

# Ambiente = production (logging JSON, JWT verification strict, no dev fallback).
API_ENV=production

# SECURITY: solo 1 worker per garantire rate-limit per-utente consistente.
# Per multi-worker VEDI SECURITY.md §6 (richiede Redis backend).
API_WORKERS=1

# --- CORS PRODUZIONE ----------------------------------------------------------
# Lista ESPLICITA domini del tuo frontend (mai wildcard `*` con credentials).
# Esempi (adatta al tuo dominio reale):
CORS_ORIGINS=https://app.spesemed.it,https://admin.spesemed.it
CORS_ALLOW_CREDENTIALS=false

# --- Admin & secrets ---------------------------------------------------------

# 32+ chars URL-safe base64. Genera con: ./deployment/GENERATE_SECRETS.sh
# NON inserire il valore raw qui in produzione (usa vault + env injection).
# ADMIN_TOKEN=<da vault>

# Supabase service_role key (Secrets Manager).
# SUPABASE_SERVICE_KEY=<da vault>
# SUPABASE_URL=https://<tuoprogetto>.supabase.co
# SUPABASE_JWT_SECRET=<da vault>

# OpenRouter API key (Secrets Manager).
# OPENROUTER_API_KEY=<da vault>

# Sentry DSN (Secrets Manager).
# SENTRY_DSN=<da vault>

# --- Monitoring & alerting ---------------------------------------------------

# Abilita Prometheus metrics (protetto da reverse proxy IP allowlist).
PROMETHEUS_METRICS_ENABLED=true

# --- Upload limits (production-conservative) ---------------------------------

# Defense in depth: proxy blocca a 25M (Caddyfile/nginx.conf anti-OOM esterno),
# app layer blocca a 15M (FastAPI StreamingAbort secondo livello).
# I numeri sono DIVERSI intenzionalmente: se qualcuno disabilita il proxy, l'app
# layer rimane un fallback. Vedi SECURITY.md §C1 anti-OOM rationale.
MAX_UPLOAD_SIZE_MB=15
MAX_SYNC_FILES=2
MAX_ASYNC_FILES=30

# --- Rate limits (production-conservative) ----------------------------------

RATE_LIMIT_EXTRACT=5/minute
RATE_LIMIT_JOBS=30/minute
RATE_LIMIT_LOGIN=3/minute
RATE_LIMIT_SIGNUP=1/hour
RATE_LIMIT_REFRESH=20/minute
RATE_LIMIT_LOGOUT=10/minute

# In produzione multi-worker: Redis backend (vedi SECURITY.md §6 H1).
# RATE_LIMIT_STORAGE_BACKEND=redis://redis-host:6379

# --- Nessuna signup self-service in produzione (admin-managed onboarding) ---

ALLOW_SIGNUP=false

# =============================================================================
# VERIFICA POST-DEPLOY (esegui dopo aver popolato .env):
# =============================================================================
#   python tests/audit_pre_go_live.py
#   ./deployment/RUN_OPERATIONS.sh https://api.tuodominio.it
# =============================================================================
